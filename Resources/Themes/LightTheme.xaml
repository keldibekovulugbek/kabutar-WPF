<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors (Based on Figma Design) -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EDE9FE"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666"/>
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#999999"/>

    <!-- Primary Purple (Figma #8B5CF6) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#6D28D9"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

</ResourceDictionary>
