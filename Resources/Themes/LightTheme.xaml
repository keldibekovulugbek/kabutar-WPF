<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme — Clean Minimal -->

    <SolidColorBrush x:Key="BackgroundBrush"         Color="#FAFAFA"/>
    <SolidColorBrush x:Key="SurfaceBrush"             Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#F4F4F6"/>
    <SolidColorBrush x:Key="InputBackgroundBrush"     Color="#F0F0F4"/>
    <SolidColorBrush x:Key="HoverBrush"               Color="#F0EEF8"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"        Color="#EDE9FE"/>

    <SolidColorBrush x:Key="TextBrush"            Color="#111827"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"   Color="#6B7280"/>
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>

    <SolidColorBrush x:Key="PrimaryBrush"        Color="#7C3AED"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#6D28D9"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#5B21B6"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#E9E9EE"/>

    <SolidColorBrush x:Key="SentMessageBrush"         Color="#7C3AED"/>
    <SolidColorBrush x:Key="ReceivedMessageBrush"     Color="#F0F0F4"/>
    <SolidColorBrush x:Key="SentMessageTextBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ReceivedMessageTextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SentMessageTimeBrush"     Color="#C4B5FD"/>
    <SolidColorBrush x:Key="ReceivedMessageTimeBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="ReadStatusBlueBrush"      Color="#7C3AED"/>
    <SolidColorBrush x:Key="ReadStatusGrayBrush"      Color="#D1D5DB"/>

    <SolidColorBrush x:Key="ErrorBrush"   Color="#EF4444"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush"  Color="#DC2626"/>

</ResourceDictionary>
