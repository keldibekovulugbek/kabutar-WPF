<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme — Clean Minimal -->

    <SolidColorBrush x:Key="BackgroundBrush"         Color="#111118"/>
    <SolidColorBrush x:Key="SurfaceBrush"             Color="#18181F"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#1E1E28"/>
    <SolidColorBrush x:Key="InputBackgroundBrush"     Color="#22222E"/>
    <SolidColorBrush x:Key="HoverBrush"               Color="#26263A"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"        Color="#2D1F52"/>

    <SolidColorBrush x:Key="TextBrush"            Color="#F1F1F5"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"   Color="#8A8AA0"/>
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#5C5C74"/>

    <SolidColorBrush x:Key="PrimaryBrush"        Color="#7C3AED"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#6D28D9"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#5B21B6"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#26263A"/>

    <SolidColorBrush x:Key="SentMessageBrush"         Color="#6D28D9"/>
    <SolidColorBrush x:Key="ReceivedMessageBrush"     Color="#22222E"/>
    <SolidColorBrush x:Key="SentMessageTextBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ReceivedMessageTextBrush" Color="#F1F1F5"/>
    <SolidColorBrush x:Key="SentMessageTimeBrush"     Color="#C4B5FD"/>
    <SolidColorBrush x:Key="ReceivedMessageTimeBrush" Color="#5C5C74"/>
    <SolidColorBrush x:Key="ReadStatusBlueBrush"      Color="#A78BFA"/>
    <SolidColorBrush x:Key="ReadStatusGrayBrush"      Color="#3F3F56"/>

    <SolidColorBrush x:Key="ErrorBrush"   Color="#EF4444"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush"  Color="#DC2626"/>

</ResourceDictionary>
