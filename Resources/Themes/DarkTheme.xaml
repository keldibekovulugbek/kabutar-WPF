<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors (Based on Figma Design) -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#3A3A3A"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#777777"/>

    <!-- Primary Purple (Same as light theme) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#6D28D9"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#444444"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>

</ResourceDictionary>
