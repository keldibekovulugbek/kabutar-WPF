<Window x:Class="Kabutar_WPF.Views.ClearChatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chatni tozalash"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>

    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="30" ShadowDepth="0"/>
        </Border.Effect>
        <StackPanel Margin="24,24,24,20">


            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">


                <Grid Width="54" Height="54" Margin="0,0,16,0" VerticalAlignment="Top">

                    <Border x:Name="InitialsBorder"
                            Width="54" Height="54"
                            CornerRadius="27"
                            Background="{DynamicResource PrimaryBrush}">
                        <TextBlock x:Name="InitialsText"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="PhotoBorder"
                            Width="54" Height="54"
                            CornerRadius="27"
                            Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="PhotoBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>


                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Chatni tozalash"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="SubText"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="260"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>


            <TextBlock Text="Bu amalni qaytarib bo'lmaydi."
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,16"/>


            <CheckBox x:Name="AlsoDeleteCheckBox"
                      FontSize="14"
                      Foreground="{DynamicResource TextBrush}"
                      Margin="0,0,0,24"
                      Cursor="Hand">
                <CheckBox.Content>
                    <TextBlock x:Name="CheckboxLabel"
                               FontSize="14"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap"/>
                </CheckBox.Content>
            </CheckBox>


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Button Grid.Column="0"
                        Content="Bekor qilish"
                        Click="Cancel_Click"
                        Height="40"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryBrush}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>


                <Button Grid.Column="2"
                        Content="O'chirish"
                        Click="Delete_Click"
                        Height="40"
                        Cursor="Hand"
                        Background="#22E53935"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#E53935">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#44E53935"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</Window>
