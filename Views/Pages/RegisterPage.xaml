<Page x:Class="Kabutar_WPF.Views.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RegisterPage">

    <Grid>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <Label Content="Create an Account"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextColor}"
                   HorizontalAlignment="Center" />

            <TextBlock Text="First Name"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Left" />
            <TextBox Width="250"
                     Height="30"
                     Margin="0,2,0,0"
                     Style="{StaticResource TextBoxStyle}"
                     Background="{StaticResource TextBoxBackground}"
                     Foreground="{StaticResource TextColor}"
                     BorderBrush="{StaticResource AccentColor}"
                     Text="{Binding Firstname, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Last Name"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Left" />
            <TextBox Width="250"
                     Height="30"
                     Margin="0,2,0,0"
                     Style="{StaticResource TextBoxStyle}"
                     Background="{StaticResource TextBoxBackground}"
                     Foreground="{StaticResource TextColor}"
                     BorderBrush="{StaticResource AccentColor}"
                     Text="{Binding Lastname, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Email"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Left" />
            <TextBox Width="250"
                     Height="30"
                     Margin="0,2,0,0"
                     Style="{StaticResource TextBoxStyle}"
                     Background="{StaticResource TextBoxBackground}"
                     Foreground="{StaticResource TextColor}"
                     BorderBrush="{StaticResource AccentColor}"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Username"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Left" />
            <TextBox Width="250"
                     Height="30"
                     Margin="0,2,0,0"
                     Style="{StaticResource TextBoxStyle}"
                     Background="{StaticResource TextBoxBackground}"
                     Foreground="{StaticResource TextColor}"
                     BorderBrush="{StaticResource AccentColor}"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Password"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Left" />
            <PasswordBox Width="250"
                         Height="30"
                         Margin="0,2,0,0"
                         Style="{StaticResource PasswordBoxStyle}"
                         Background="{StaticResource TextBoxBackground}"
                         Foreground="{StaticResource TextColor}"
                         BorderBrush="{StaticResource AccentColor}"
                         PasswordChanged="PasswordBox_PasswordChanged" />

            <!-- Password error -->
            <TextBlock Text="{Binding PasswordError}"
                       Foreground="Red"
                       FontSize="12"
                       Margin="0,5,0,0"
                       Visibility="{Binding PasswordError, Converter={StaticResource StringToVisibilityConverter}}" />

            <TextBlock Text="Confirm Password"
                       Foreground="{StaticResource TextColor}"
                       HorizontalAlignment="Left"
                       Margin="0,10,0,0" />
            
            <PasswordBox Width="250"
                         Height="30"
                         Margin="0,2,0,0"
                         Style="{StaticResource PasswordBoxStyle}"
                         Background="{StaticResource TextBoxBackground}"
                         Foreground="{StaticResource TextColor}"
                         BorderBrush="{StaticResource AccentColor}"
                         PasswordChanged="PasswordBox_ConfirmPasswordChanged" />

            <!-- Confirm Password Error -->
            <TextBlock Text="{Binding ConfirmPasswordError}"
                       Foreground="Red"
                       FontSize="12"
                       Margin="0,5,0,0"
                       Visibility="{Binding ConfirmPasswordError, Converter={StaticResource StringToVisibilityConverter}}" />

            <!-- Register Button -->
            <Button Content="Register"
                    Width="250"
                    Height="35"
                    Margin="0,10,0,0"
                    Style="{StaticResource ButtonStyle}"
                    Background="{StaticResource AccentColor}"
                    Foreground="White"
                    Command="{Binding RegisterCommand}" />
            
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       FontSize="12"
                       Margin="0,5,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

            <!-- Login Pagega qaytish -->
            <Button Content="Already have an account? Log in"
                    Background="Transparent"
                    Foreground="{StaticResource AccentColor}"
                    BorderBrush="Transparent"
                    Width="250"
                    Margin="0,10,0,0"
                    Height="30"
                    Click="BackToLoginButton_Click" />
        </StackPanel>
    </Grid>
</Page>
