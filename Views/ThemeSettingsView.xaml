<UserControl x:Class="Kabutar_WPF.Views.ThemeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryBrush}"
                Padding="20,15">
            <Grid>
                <TextBlock Text="Mavzuni sozlash"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Button Content="&#x2715;"
                        Click="Close_Click"
                        HorizontalAlignment="Right"
                        Width="30" Height="30"
                        Background="#33FFFFFF"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>


        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20">


                <TextBlock Text="Mavzu rejimi"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,25">

                    <Border x:Name="LightThemeButton"
                            Width="130" Height="100"
                            BorderThickness="3"
                            BorderBrush="{DynamicResource BorderBrush}"
                            CornerRadius="10"
                            Cursor="Hand"
                            Margin="0,0,15,0"
                            MouseDown="LightTheme_Click">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#F5F5F5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#9728;"
                                       FontSize="32"
                                       HorizontalAlignment="Center"
                                       Foreground="#FFA500"/>
                            <TextBlock Text="Kunduzgi"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="#333333"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>


                    <Border x:Name="DarkThemeButton"
                            Width="130" Height="100"
                            BorderThickness="3"
                            BorderBrush="{DynamicResource BorderBrush}"
                            CornerRadius="10"
                            Cursor="Hand"
                            MouseDown="DarkTheme_Click">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2D2D2D" Offset="0"/>
                                <GradientStop Color="#1A1A1A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#9790;"
                                       FontSize="32"
                                       HorizontalAlignment="Center"
                                       Foreground="#FFD700"/>
                            <TextBlock Text="Tungi"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="#FFFFFF"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,5,0,20"/>


                <TextBlock Text="Chat orqa foni"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0"
                            Width="150" Height="100"
                            CornerRadius="10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,20,0">
                        <Grid>

                            <Border x:Name="DefaultBackgroundBorder"
                                    CornerRadius="10"
                                    Background="{DynamicResource BackgroundBrush}">
                                <TextBlock Text="Standart"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>


                            <Border x:Name="CustomBackgroundBorder"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="BackgroundPreviewImage"
                                                Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Rasm tanlash"
                                Click="SelectBackground_Click"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                Padding="20,10"
                                BorderThickness="0"
                                Cursor="Hand"
                                Width="140"
                                HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="ClearBackgroundButton"
                                Content="Tozalash"
                                Click="ClearBackground_Click"
                                Background="Transparent"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Padding="20,10"
                                BorderThickness="0"
                                Cursor="Hand"
                                Width="140"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,5,0,20"/>


                <TextBlock Text="Tekst o'lchami"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">

                    <Border x:Name="SmallFontButton"
                            Width="90" Height="60"
                            BorderThickness="3"
                            BorderBrush="{DynamicResource BorderBrush}"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            Cursor="Hand"
                            Margin="0,0,10,0"
                            MouseDown="SmallFont_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Aa"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Kichik"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>


                    <Border x:Name="MediumFontButton"
                            Width="90" Height="60"
                            BorderThickness="3"
                            BorderBrush="{DynamicResource BorderBrush}"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            Cursor="Hand"
                            Margin="0,0,10,0"
                            MouseDown="MediumFont_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Aa"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="O'rta"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>


                    <Border x:Name="LargeFontButton"
                            Width="90" Height="60"
                            BorderThickness="3"
                            BorderBrush="{DynamicResource BorderBrush}"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            Cursor="Hand"
                            MouseDown="LargeFont_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Aa"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Katta"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>


                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,10,0,0">
                    <TextBlock x:Name="FontPreviewText"
                               Text="Bu matnning namunasi. Siz tanlagan o'lcham asosida xabarlar shu tarzda ko'rinadi."
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

            </StackPanel>
        </ScrollViewer>


        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="30,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Bekor qilish"
                        Click="Cancel_Click"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="25,10"
                        Margin="0,0,10,0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2"
                        Content="Saqlash"
                        Click="Save_Click"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White"
                        Padding="35,10"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
