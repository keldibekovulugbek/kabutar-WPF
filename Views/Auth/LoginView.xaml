<Window x:Class="Kabutar_WPF.Views.Auth.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Kabutar_WPF.ViewModels.Auth"
        Title="Kabutar - Login"
        Height="600"
        Width="900"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Kabutar"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="15,0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- Theme Toggle -->
                    <Button Content="🌙"
                            Width="35"
                            Height="35"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="16"
                            Cursor="Hand"
                            Click="ThemeToggle_Click"/>

                    <!-- Close Button -->
                    <Button Content="✕"
                            Width="35"
                            Height="35"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="16"
                            Cursor="Hand"
                            Click="Close_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="450">

                <!-- Logo/Title -->
                <TextBlock Text="Kabutar"
                           FontSize="48"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,30"/>

                <!-- Welcome Text -->
                <TextBlock Text="Welcome back"
                           FontSize="32"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,40"/>

                <!-- Username TextBox -->
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Tag="Username or Email"
                         Margin="0,0,0,15"/>

                <!-- Password Box -->
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource ModernPasswordBoxStyle}"
                             Tag="Password"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Margin="0,0,0,10"/>

                <!-- Forgot Password -->
                <Button Content="Forgot password?"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,25"
                        Command="{Binding NavigateToForgotPasswordCommand}"/>

                <!-- Login Button -->
                <Button Content="Log in"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,0,20"
                        Command="{Binding LoginCommand}"/>

                <!-- Sign Up Link -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <TextBlock Text="New user? "
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="14"/>
                    <Button Content="Sign up"
                            Style="{StaticResource TextButtonStyle}"
                            Command="{Binding NavigateToRegisterCommand}"/>
                </StackPanel>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Loading Indicator -->
                <TextBlock Text="Loading..."
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
