<Window x:Class="Kabutar_WPF.Views.Auth.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Kabutar_WPF.ViewModels.Auth"
        xmlns:core="clr-namespace:Kabutar_WPF.Core"
        Title="Kabutar — Ro'yxatdan o'tish"
        Height="640" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="8,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Image Source="/Assets/kabutar_logo.png" Width="16" Height="16"
                           Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Kabutar" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="32" Height="32" Content="🌙" BorderThickness="0"
                            Cursor="Hand" Click="ThemeToggle_Click"
                            Foreground="{DynamicResource SecondaryTextBrush}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="32" Height="32" Content="−" BorderThickness="0"
                            FontSize="18" Cursor="Hand" Click="Minimize_Click"
                            Foreground="{DynamicResource SecondaryTextBrush}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="32" Height="32" Content="✕" BorderThickness="0"
                            FontSize="13" Cursor="Hand" Click="Close_Click"
                            Foreground="{DynamicResource SecondaryTextBrush}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFEEEE"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center" Margin="40,0,40,28">

                    <TextBlock Text="Hisob yaratish"
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="Barcha maydonlarni to'ldiring"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,24"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Firstname, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Ism" Style="{StaticResource ModernTextBoxStyle}" Height="46"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding Lastname, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Familiya" Style="{StaticResource ModernTextBoxStyle}" Height="46"/>
                    </Grid>

                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Email" Style="{StaticResource ModernTextBoxStyle}"
                             Height="46" Margin="0,0,0,10"/>

                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Username" Style="{StaticResource ModernTextBoxStyle}"
                             Height="46" Margin="0,0,0,10"/>

                    <PasswordBox x:Name="PasswordBox"
                                 Tag="Parol" Style="{StaticResource ModernPasswordBoxStyle}"
                                 Height="46" Margin="0,0,0,16"
                                 core:PasswordBoxHelper.Attach="True"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 GotFocus="PasswordBox_GotFocus"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="13" TextAlignment="Center"
                               Margin="0,0,0,10" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Content="Ro'yxatdan o'tish"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="46" Margin="0,0,0,16"
                            Command="{Binding RegisterCommand}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Hisobingiz bormi? "
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
                        <TextBlock HorizontalAlignment="Center">
                            <Hyperlink Command="{Binding NavigateToLoginCommand}" TextDecorations="None">
                                <Run Text="Kirish" FontSize="13" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Loading overlay -->
                <Border Background="#99000000" CornerRadius="0,0,16,16"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Yuklanmoqda..."
                               Foreground="White" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
