<Window x:Class="Kabutar_WPF.Views.Auth.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Kabutar_WPF.ViewModels.Auth"
        Title="Register" Height="600" Width="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.DataContext>
        <vm:RegisterViewModel/>
    </Window.DataContext>

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PrimaryBrush}"
                    CornerRadius="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Kabutar"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="15,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="🌙"
                                Width="40"
                                Height="35"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="16"
                                Cursor="Hand"
                                Click="ThemeToggle_Click"/>
                        <Button Content="−"
                                Width="40"
                                Height="35"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="20"
                                Cursor="Hand"
                                Click="Minimize_Click"/>
                        <Button Content="☐"
                                Width="40"
                                Height="35"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="16"
                                Cursor="Hand"
                                Click="Maximize_Click"/>
                        <Button Content="✕"
                                Width="40"
                                Height="35"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="16"
                                Cursor="Hand"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <StackPanel Width="450"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <!-- Logo -->
                    <TextBlock Text="Kabutar"
                               FontSize="48"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,10"/>

                    <!-- Title -->
                    <TextBlock Text="Sign up"
                               FontSize="32"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,30"/>

                    <!-- First Name -->
                    <TextBox Text="{Binding Firstname, UpdateSourceTrigger=PropertyChanged}"
                             Tag="First name"
                             Style="{StaticResource ModernTextBoxStyle}"
                             FontSize="16"
                             Margin="0,0,0,12"
                             Height="50"/>

                    <!-- Last Name -->
                    <TextBox Text="{Binding Lastname, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Last name"
                             Style="{StaticResource ModernTextBoxStyle}"
                             FontSize="16"
                             Margin="0,0,0,12"
                             Height="50"/>

                    <!-- Email -->
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Email"
                             Style="{StaticResource ModernTextBoxStyle}"
                             FontSize="16"
                             Margin="0,0,0,12"
                             Height="50"/>

                    <!-- Username -->
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Tag="User name"
                             Style="{StaticResource ModernTextBoxStyle}"
                             FontSize="16"
                             Margin="0,0,0,12"
                             Height="50"/>

                    <!-- Password -->
                    <PasswordBox x:Name="PasswordBox"
                                 Tag="Password"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 FontSize="16"
                                 Margin="0,0,0,20"
                                 Height="50"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 GotFocus="PasswordBox_GotFocus"/>

                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="14"
                               TextAlignment="Center"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Next Button -->
                    <Button Content="Next"
                            Style="{StaticResource PrimaryButtonStyle}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Height="50"
                            Margin="0,0,0,20"
                            Command="{Binding RegisterCommand}"
                            Cursor="Hand"/>

                    <!-- Log in Link -->
                    <TextBlock HorizontalAlignment="Center">
                        <Hyperlink Command="{Binding NavigateToLoginCommand}"
                                   TextDecorations="None">
                            <Run Text="Log in"
                                 FontSize="16"
                                 Foreground="{DynamicResource PrimaryBrush}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- Loading Overlay -->
                <Border Background="#80000000"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                        Grid.RowSpan="2">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Loading..."
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
