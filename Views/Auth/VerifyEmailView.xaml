<Window x:Class="Kabutar_WPF.Views.Auth.VerifyEmailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Kabutar_WPF.ViewModels.Auth"
        Title="Kabutar — Tasdiqlash"
        Height="460" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>

        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Image Source="/Assets/kabutar_logo.png" Width="16" Height="16"
                           Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Kabutar" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="32" Height="32" Content="🌙" BorderThickness="0"
                            Cursor="Hand" Click="ThemeToggle_Click" Foreground="{DynamicResource SecondaryTextBrush}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="32" Height="32" Content="−" FontSize="18" BorderThickness="0"
                            Cursor="Hand" Click="Minimize_Click" Foreground="{DynamicResource SecondaryTextBrush}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="32" Height="32" Content="✕" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="Close_Click" Foreground="{DynamicResource SecondaryTextBrush}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFEEEE"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center" Margin="40,0,40,32">

                    <TextBlock Text="📧" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <TextBlock Text="Emailni tasdiqlang"
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Email manzilingizga yuborilgan kodni kiriting."
                               FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,0,24"/>

                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Tasdiqlash kodi"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="46" Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="13" TextAlignment="Center"
                               Margin="0,0,0,10" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Content="Tasdiqlash"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="46" Margin="0,0,0,16"
                            Command="{Binding VerifyCommand}"/>

                    <TextBlock HorizontalAlignment="Center">
                        <Hyperlink Command="{Binding NavigateBackCommand}" TextDecorations="None">
                            <Run Text="Orqaga" FontSize="13" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <Border Background="#99000000" CornerRadius="0,0,16,16"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Tekshirilmoqda..."
                               Foreground="White" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
