<Window x:Class="Kabutar_WPF.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kabutar_WPF.Views"
        xmlns:helpers="clr-namespace:Kabutar_WPF.Helpers"
        mc:Ignorable="d"
        Title="Kabutar" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            
            <ColumnDefinition Width="350"/>
            
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                
                <Border Grid.Row="0"
                        Background="{DynamicResource PrimaryBrush}"
                        Padding="20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        
                        <Button x:Name="HamburgerButton"
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="HamburgerButton_Click"
                                Margin="0,0,15,0">
                            <Button.Content>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Rectangle Fill="White" Height="3" Width="24" Margin="0,2"/>
                                    <Rectangle Fill="White" Height="3" Width="24" Margin="0,2"/>
                                    <Rectangle Fill="White" Height="3" Width="24" Margin="0,2"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#55FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Grid.Column="1"
                                   Text="Kabutar"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        Padding="15,10">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10"
                             FontSize="14"
                             Background="{DynamicResource BackgroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Qidirish..."
                                                                   Foreground="#999"
                                                                   Margin="5,0,0,0"
                                                                   FontSize="14"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Border>

                
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding SearchResults}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.Resources>
                        
                        <DataTemplate x:Key="UserSearchResultTemplate">
                            <Button Background="Transparent"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Padding="15,12"
                                    HorizontalContentAlignment="Stretch"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.SelectUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    
                                    <Grid Grid.Column="0"
                                          Grid.RowSpan="2"
                                          Width="50"
                                          Height="50"
                                          Margin="0,0,12,0">
                                        
                                        <Border Width="50"
                                                Height="50"
                                                CornerRadius="25"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Visibility="{Binding ProfilePicture, Converter={StaticResource NoImageToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        
                                        <Border Width="50"
                                                Height="50"
                                                CornerRadius="25"
                                                Visibility="{Binding ProfilePicture, Converter={StaticResource ImagePathToVisibilityConverter}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding ProfilePicture, Converter={StaticResource ImagePathToUrlConverter}}"
                                                            Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>

                                        
                                        <Ellipse Width="14"
                                                 Height="14"
                                                 Fill="#4CAF50"
                                                 Stroke="{DynamicResource SurfaceBrush}"
                                                 StrokeThickness="2"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom"
                                                 Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>

                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding Username, StringFormat='@{0}'}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>

                        
                        <DataTemplate x:Key="MessageSearchResultTemplate">
                            <Button Background="Transparent"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Padding="15,12"
                                    HorizontalContentAlignment="Stretch"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.SelectMessageResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                   
                                    
                                    
                                    <Grid Grid.Column="0"
                                          Grid.RowSpan="2"
                                          Width="50"
                                          Height="50"
                                          Margin="0,0,12,0">
                                        
                                        <Border Width="50"
                                                Height="50"
                                                CornerRadius="25"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Visibility="{Binding ProfilePicture, Converter={StaticResource NoImageToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        
                                        <Border Width="50"
                                                Height="50"
                                                CornerRadius="25"
                                                Visibility="{Binding ProfilePicture, Converter={StaticResource ImagePathToVisibilityConverter}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding ProfilePicture, Converter={StaticResource ImagePathToUrlConverter}}"
                                                            Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>

                                        
                                        <Ellipse Width="14"
                                                 Height="14"
                                                 Fill="#4CAF50"
                                                 Stroke="{DynamicResource SurfaceBrush}"
                                                 StrokeThickness="2"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom"
                                                 Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        
                                        <TextBlock 
                                                   Text="{Binding FullName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" />

                                        
                                        <TextBlock
                                                   Text="{Binding MessageContent}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.Resources>

                    <ListBox.ItemTemplateSelector>
                        <local:SearchResultTemplateSelector
                            UserTemplate="{StaticResource UserSearchResultTemplate}"
                            MessageTemplate="{StaticResource MessageSearchResultTemplate}"/>
                    </ListBox.ItemTemplateSelector>
                </ListBox>

                
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Chats}"
                         SelectedItem="{Binding SelectedChat}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="15,12" Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                
                                <Grid Grid.Column="0" Grid.RowSpan="2"
                                      Width="50" Height="50"
                                      Margin="0,0,12,0">
                                    
                                    <Border Width="50" Height="50"
                                            CornerRadius="25"
                                            Background="{DynamicResource PrimaryBrush}"
                                            Visibility="{Binding ProfilePicture, Converter={StaticResource NoImageToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                   Foreground="White"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    
                                    <Border Width="50" Height="50"
                                            CornerRadius="25"
                                            Visibility="{Binding ProfilePicture, Converter={StaticResource ImagePathToVisibilityConverter}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ProfilePicture, Converter={StaticResource ImagePathToUrlConverter}}"
                                                        Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>

                                    
                                    <Ellipse Width="14" Height="14"
                                             Fill="#4CAF50"
                                             Stroke="{DynamicResource SurfaceBrush}"
                                             StrokeThickness="2"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom"
                                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>

                                
                                <TextBlock Grid.Column="1" Grid.Row="0"
                                           Text="{Binding Name}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>

                                
                                <TextBlock Grid.Column="1" Grid.Row="1"
                                           Text="{Binding LastMessage}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0"/>

                                
                                <StackPanel Grid.Column="2" Grid.Row="0"
                                            Orientation="Vertical"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding LastMessageTime, StringFormat='{}{0:HH:mm}'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <Border Background="{DynamicResource PrimaryBrush}"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding UnreadCount, Converter={StaticResource CountToVisibilityConverter}}">
                                        <TextBlock Text="{Binding UnreadCount}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        
        <Grid Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,15">
                <Grid>
                    
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalContentAlignment="Left"
                            Click="ChatUserInfo_Click"
                            Visibility="{Binding SelectedChat, Converter={StaticResource NotNullToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="5">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            
                            <Grid Width="45" Height="45" Margin="0,0,12,0">
                                
                                <Border Width="45" Height="45"
                                        CornerRadius="22.5"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Visibility="{Binding SelectedChat.ProfilePicture, Converter={StaticResource NoImageToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SelectedChat.Name, Converter={StaticResource InitialsConverter}}"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                
                                <Border Width="45" Height="45"
                                        CornerRadius="22.5"
                                        Visibility="{Binding SelectedChat.ProfilePicture, Converter={StaticResource ImagePathToVisibilityConverter}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding SelectedChat.ProfilePicture, Converter={StaticResource ImagePathToUrlConverter}}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                
                                <Ellipse Width="12" Height="12"
                                         Fill="#4CAF50"
                                         Stroke="{DynamicResource SurfaceBrush}"
                                         StrokeThickness="2"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Visibility="{Binding SelectedChat.IsOnline, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedChat.Name}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,2,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LastSeenMultiConverter}">
                                            <Binding Path="SelectedChat.IsOnline"/>
                                            <Binding Path="SelectedChat.LastActive"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    
                    <TextBlock Text=""
                               FontSize="16"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding SelectedChat, Converter={StaticResource NullToVisibilityConverter}}" />
                </Grid>
            </Border>

            
            <Border x:Name="ChatBackgroundBorder"
                    Grid.Row="1"
                    Background="{DynamicResource BackgroundBrush}"
                    Visibility="{Binding SelectedChat, Converter={StaticResource NotNullToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="20"
                              Background="Transparent">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.Resources>
                        
                        <DataTemplate x:Key="DateSeparatorTemplate">
                            <Grid Margin="0,15,0,10">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="12"
                                        Padding="12,6"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DateText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>

                        
                        <DataTemplate x:Key="MessageTemplate">
                            <Grid Margin="0,5">
                                <Border Background="{Binding Message.IsFromMe, Converter={StaticResource MessageBackgroundConverter}}"
                                        CornerRadius="10"
                                        Padding="12,8"
                                        MaxWidth="400"
                                        HorizontalAlignment="{Binding Message.IsFromMe, Converter={StaticResource MessageAlignmentConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Message.Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding Message.IsFromMe, Converter={StaticResource MessageForegroundConverter}}"
                                                   FontSize="{DynamicResource ChatFontSize}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Message.SentAt, StringFormat='{}{0:HH:mm}'}"
                                                       FontSize="11"
                                                       Foreground="{Binding Message.IsFromMe, Converter={StaticResource MessageTimeForegroundConverter}}"/>
                                            
                                            <TextBlock Text="{Binding Message.IsRead, Converter={StaticResource ReadStatusConverter}}"
                                                       FontSize="11"
                                                       Foreground="{Binding Message.IsRead, Converter={StaticResource ReadStatusColorConverter}}"
                                                       Margin="4,0,0,0"
                                                       Visibility="{Binding Message.IsFromMe, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.Resources>

                    <ItemsControl.ItemTemplateSelector>
                        <helpers:MessageItemTemplateSelector
                            DateSeparatorTemplate="{StaticResource DateSeparatorTemplate}"
                            MessageTemplate="{StaticResource MessageTemplate}"/>
                    </ItemsControl.ItemTemplateSelector>
                </ItemsControl>
                </ScrollViewer>
            </Border>

            
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding SelectedChat, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="💬"
                           FontSize="64"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Chatni tanlang va suhbatni boshlang"
                           FontSize="16"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,15"
                    Visibility="{Binding SelectedChat, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,10"
                             FontSize="14"
                             Background="{DynamicResource BackgroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             VerticalAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                        </TextBox.InputBindings>
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Xabar yozing..."
                                                                   Foreground="#999"
                                                                   Margin="5,0,0,0"
                                                                   FontSize="14"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="1"
                            Content="Yuborish"
                            Command="{Binding SendMessageCommand}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            Padding="25,10"
                            Margin="10,0,0,0"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        
        <Grid x:Name="MenuOverlay"
              Grid.ColumnSpan="2"
              Background="#80000000"
              Visibility="Collapsed"
              MouseDown="MenuOverlay_MouseDown">

            
            <Border x:Name="SideMenuPanel"
                    Width="280"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuTransform" X="-280"/>
                </Border.RenderTransform>

                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="15" ShadowDepth="0"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    
                    <Border Grid.Row="0"
                            Background="{DynamicResource PrimaryBrush}"
                            Padding="20,25,20,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            
                            <Grid Grid.Column="0"
                                  Width="60"
                                  Height="60"
                                  Margin="0,0,15,0">
                                
                                <Border Width="60" Height="60"
                                        CornerRadius="30"
                                        Background="White">
                                    <TextBlock x:Name="MenuUserInitials"
                                               Text=""
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                
                                <Border x:Name="MenuUserImageBorder"
                                        Width="60" Height="60"
                                        CornerRadius="30"
                                        Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush x:Name="MenuUserImage"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="MenuUserName"
                                           Text="Loading..."
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Profilni ko'rish"
                                           FontSize="13"
                                           Foreground="#E0FFFFFF"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        
                        <Button Content="Profilni sozlash"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                Cursor="Hand"
                                FontSize="15"
                                Click="ProfileSettings_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        
                        <Button Content="Mavzuni almashtirish"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                Cursor="Hand"
                                FontSize="15"
                                Click="ChangeTheme_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        
                        <Button Content="Sozlamalar"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                Cursor="Hand"
                                FontSize="15"
                                Click="Settings_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Separator Margin="10,10" Background="{DynamicResource BorderBrush}"/>

                        
                        <Button Content="Chiqish"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                Foreground="#F44336"
                                Cursor="Hand"
                                FontSize="15"
                                Click="Logout_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
