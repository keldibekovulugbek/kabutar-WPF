<Window x:Class="Kabutar_WPF.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kabutar_WPF.Views"
        xmlns:helpers="clr-namespace:Kabutar_WPF.Helpers"
        mc:Ignorable="d"
        Title="Kabutar" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════
             LEFT SIDEBAR
        ═══════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="HamburgerButton"
                                Grid.Column="0"
                                Width="36" Height="36"
                                Margin="0,0,10,0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="HamburgerButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="18">
                                                        <Rectangle Fill="{DynamicResource SecondaryTextBrush}" Height="1.5" RadiusX="1" RadiusY="1" Margin="0,0,0,4"/>
                                                        <Rectangle Fill="{DynamicResource SecondaryTextBrush}" Height="1.5" RadiusX="1" RadiusY="1" Margin="0,0,0,4"/>
                                                        <Rectangle Fill="{DynamicResource SecondaryTextBrush}" Height="1.5" RadiusX="1" RadiusY="1"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Assets/kabutar_logo.png"
                                   Width="24" Height="24" Margin="0,0,8,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Kabutar"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Search -->
                <Border Grid.Row="1" Padding="14,8">
                    <Border Background="{DynamicResource InputBackgroundBrush}"
                            CornerRadius="10" Padding="10,0">
                        <Grid>
                            <TextBlock Text="🔍" FontSize="13"
                                       Foreground="{DynamicResource PlaceholderTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       HorizontalAlignment="Left"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="22,10,8,10"
                                     FontSize="13"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextBrush}"
                                     CaretBrush="{DynamicResource PrimaryBrush}"
                                     VerticalContentAlignment="Center">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="Qidirish..."
                                                                           Foreground="{DynamicResource PlaceholderTextBrush}"
                                                                           Margin="22,10,0,0"
                                                                           FontSize="13"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>
                </Border>

                <!-- Search results -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding SearchResults}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.Resources>
                        <DataTemplate x:Key="UserSearchResultTemplate">
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="14,10" HorizontalContentAlignment="Stretch"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.SelectUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="38" Height="38" Margin="0,0,10,0">
                                        <Border Width="38" Height="38" CornerRadius="19"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Visibility="{Binding ProfilePicture, Converter={StaticResource NoImageToVisibilityConverter}}">
                                            <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                                                       Foreground="White" FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="38" Height="38" CornerRadius="19"
                                                Visibility="{Binding ProfilePicture, Converter={StaticResource ImagePathToVisibilityConverter}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding ProfilePicture, Converter={StaticResource ImagePathToUrlConverter}}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <Ellipse Width="10" Height="10" Fill="#22C55E"
                                                 Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="1.5"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding Username, StringFormat='@{0}'}"
                                                   FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>

                        <DataTemplate x:Key="MessageSearchResultTemplate">
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="14,10" HorizontalContentAlignment="Stretch"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.SelectMessageResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="38" Height="38" Margin="0,0,10,0">
                                        <Border Width="38" Height="38" CornerRadius="19"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Visibility="{Binding ProfilePicture, Converter={StaticResource NoImageToVisibilityConverter}}">
                                            <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                                                       Foreground="White" FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="38" Height="38" CornerRadius="19"
                                                Visibility="{Binding ProfilePicture, Converter={StaticResource ImagePathToVisibilityConverter}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding ProfilePicture, Converter={StaticResource ImagePathToUrlConverter}}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding MessageContent}" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.Resources>

                    <ListBox.ItemTemplateSelector>
                        <local:SearchResultTemplateSelector
                            UserTemplate="{StaticResource UserSearchResultTemplate}"
                            MessageTemplate="{StaticResource MessageSearchResultTemplate}"/>
                    </ListBox.ItemTemplateSelector>
                </ListBox>

                <!-- Chat list -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Chats}"
                         SelectedItem="{Binding SelectedChat}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                Tag="{TemplateBinding Tag}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Chatni tozalash"
                                                              Command="{Binding PlacementTarget.Tag.ClearChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="14,10" Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Column="0" Grid.RowSpan="2"
                                      Width="40" Height="40" Margin="0,0,10,0">
                                    <Border Width="40" Height="40" CornerRadius="20"
                                            Background="{DynamicResource PrimaryBrush}"
                                            Visibility="{Binding ThumbnailOrProfile, Converter={StaticResource NoImageToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                   Foreground="White" FontSize="15" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="40" Height="40" CornerRadius="20"
                                            Visibility="{Binding ThumbnailOrProfile, Converter={StaticResource ImagePathToVisibilityConverter}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ThumbnailOrProfile, Converter={StaticResource ImagePathToUrlConverter}}"
                                                        Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <Ellipse Width="10" Height="10" Fill="#22C55E"
                                             Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="1.5"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>

                                <TextBlock Grid.Column="1" Grid.Row="0"
                                           Text="{Binding Name}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="1" Grid.Row="1"
                                           Text="{Binding LastMessage}"
                                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                           Visibility="{Binding IsTyping, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="1" Grid.Row="1"
                                           Text="yozmoqda..."
                                           FontSize="12" FontStyle="Italic"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding IsTyping, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <StackPanel Grid.Column="2" Grid.Row="0"
                                            Orientation="Vertical" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding LastMessageTime, StringFormat='{}{0:HH:mm}'}"
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <Border Background="{DynamicResource PrimaryBrush}"
                                            CornerRadius="8" Padding="5,1"
                                            Margin="0,4,0,0" HorizontalAlignment="Right"
                                            Visibility="{Binding UnreadCount, Converter={StaticResource CountToVisibilityConverter}}">
                                        <TextBlock Text="{Binding UnreadCount}"
                                                   Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             MAIN CHAT AREA
        ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,0">
                <Grid>
                    <Button Background="Transparent" BorderThickness="0"
                            Cursor="Hand" HorizontalContentAlignment="Left"
                            Click="ChatUserInfo_Click"
                            Visibility="{Binding SelectedChat, Converter={StaticResource NotNullToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="4">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="38" Height="38" Margin="0,0,10,0">
                                <Border Width="38" Height="38" CornerRadius="19"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Visibility="{Binding SelectedChat.ProfilePicture, Converter={StaticResource NoImageToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SelectedChat.Name, Converter={StaticResource InitialsConverter}}"
                                               Foreground="White" FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="38" Height="38" CornerRadius="19"
                                        Visibility="{Binding SelectedChat.ProfilePicture, Converter={StaticResource ImagePathToVisibilityConverter}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding SelectedChat.ProfilePicture, Converter={StaticResource ImagePathToUrlConverter}}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <Ellipse Width="10" Height="10" Fill="#22C55E"
                                         Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="1.5"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Visibility="{Binding SelectedChat.IsOnline, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedChat.Name}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="yozmoqda..."
                                           FontSize="11" FontStyle="Italic"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Margin="0,1,0,0"
                                           Visibility="{Binding IsRemoteTyping, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,1,0,0"
                                           Visibility="{Binding IsRemoteTyping, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LastSeenMultiConverter}">
                                            <Binding Path="SelectedChat.IsOnline"/>
                                            <Binding Path="SelectedChat.LastActive"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Clear chat button -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="34" Height="34"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Chatni tozalash"
                            Command="{Binding ClearChatCommand}"
                            CommandParameter="{Binding SelectedChat}"
                            Visibility="{Binding SelectedChat, Converter={StaticResource NotNullToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="🗑" FontSize="14"/>
                    </Button>

                    <!-- No chat placeholder -->
                    <TextBlock Text="Chatni tanlang"
                               FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedChat, Converter={StaticResource NullToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Messages area -->
            <Border x:Name="ChatBackgroundBorder"
                    Grid.Row="1"
                    AllowDrop="True"
                    Drop="ChatArea_Drop"
                    DragOver="ChatArea_DragOver"
                    Visibility="{Binding SelectedChat, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChatBackground}" Value="True">
                                <Setter Property="Background" Value="{Binding ChatBackgroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer x:Name="MessagesScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,16"
                              Background="Transparent">
                    <StackPanel>
                        <Button Content="⬆ Oldingi xabarlar"
                                Command="{Binding LoadMoreMessagesCommand}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12"
                                Padding="14,5"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Cursor="Hand"
                                Visibility="{Binding HasMoreMessages, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="16" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.Resources>

                                <DataTemplate x:Key="DateSeparatorTemplate">
                                    <Grid Margin="0,12,0,8">
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                CornerRadius="10" Padding="10,4"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DateText}"
                                                       FontSize="11" FontWeight="Medium"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>

                                <DataTemplate x:Key="MessageTemplate">
                                    <Grid Margin="0,2">
                                        <Border Background="{Binding Message.IsFromMe, Converter={StaticResource MessageBackgroundConverter}}"
                                                CornerRadius="14"
                                                Padding="{Binding Message.HasImage, Converter={StaticResource BoolToPaddingConverter}}"
                                                MaxWidth="340"
                                                ClipToBounds="True"
                                                HorizontalAlignment="{Binding Message.IsFromMe, Converter={StaticResource MessageAlignmentConverter}}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Javob berish"
                                                              Command="{Binding PlacementTarget.Tag.ReplyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Tahrirlash"
                                                              Command="{Binding PlacementTarget.Tag.EditMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Faqat menda o'chirish"
                                                              Command="{Binding PlacementTarget.Tag.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Ikki tomonlama o'chirish"
                                                              Command="{Binding PlacementTarget.Tag.DeleteMessageForBothCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <StackPanel>
                                                <!-- Normal view -->
                                                <StackPanel Visibility="{Binding Message.IsNotEditing, Converter={StaticResource BoolToVisibilityConverter}}">

                                                    <!-- Reply quote -->
                                                    <Border Visibility="{Binding Message.HasReply, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Background="#1A000000"
                                                            CornerRadius="8"
                                                            Padding="8,5"
                                                            Margin="0,0,0,6"
                                                            Cursor="Hand">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="#88FFFFFF" CornerRadius="2" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Message.ReplyToSenderName}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="#DDFFFFFF"
                                                                           Visibility="{Binding Message.IsFromMe, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <TextBlock Text="{Binding Message.ReplyToSenderName}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                                           Visibility="{Binding Message.IsFromMe, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                                <TextBlock Text="{Binding Message.ReplyToContent}"
                                                                           FontSize="11"
                                                                           Foreground="{Binding Message.IsFromMe, Converter={StaticResource MessageTimeForegroundConverter}}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="240"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Text="{Binding Message.Content}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{Binding Message.IsFromMe, Converter={StaticResource MessageForegroundConverter}}"
                                                               FontSize="{DynamicResource ChatFontSize}"
                                                               Visibility="{Binding Message.HasImage, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                                    <TextBlock Text="tahrirlangan"
                                                               FontSize="10" FontStyle="Italic"
                                                               Foreground="{Binding Message.IsFromMe, Converter={StaticResource MessageTimeForegroundConverter}}"
                                                               Visibility="{Binding Message.IsEdited, Converter={StaticResource BoolToVisibilityConverter}}"
                                                               Margin="0,1,0,0"/>

                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right"
                                                                Margin="0,3,0,0"
                                                                Visibility="{Binding Message.HasImage, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding Message.SentAt, StringFormat='{}{0:HH:mm}'}"
                                                                   FontSize="10"
                                                                   Foreground="{Binding Message.IsFromMe, Converter={StaticResource MessageTimeForegroundConverter}}"/>
                                                        <TextBlock Text="{Binding Message.IsRead, Converter={StaticResource ReadStatusConverter}}"
                                                                   FontSize="10"
                                                                   Foreground="{Binding Message.IsRead, Converter={StaticResource ReadStatusColorConverter}}"
                                                                   Margin="4,0,0,0"
                                                                   Visibility="{Binding Message.IsFromMe, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>

                                                    <Grid Visibility="{Binding Message.HasImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Image Source="{Binding Message.AttachmentUrl, Converter={StaticResource ImagePathToUrlConverter}}"
                                                               MaxHeight="260" MaxWidth="260"
                                                               MinWidth="100" MinHeight="60"
                                                               Stretch="Uniform" Cursor="Hand"
                                                               Tag="{Binding Message.AttachmentUrl}"
                                                               MouseLeftButtonUp="ChatImage_Click"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <Border Background="#88000000" CornerRadius="6"
                                                                Padding="5,2"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="0,0,5,5">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Message.SentAt, StringFormat='{}{0:HH:mm}'}"
                                                                           FontSize="10" Foreground="White"/>
                                                                <TextBlock Text="{Binding Message.IsRead, Converter={StaticResource ReadStatusConverter}}"
                                                                           FontSize="10" Foreground="White" Margin="3,0,0,0"
                                                                           Visibility="{Binding Message.IsFromMe, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Edit mode -->
                                                <StackPanel Visibility="{Binding Message.IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBox Text="{Binding Message.EditText, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="{DynamicResource ChatFontSize}"
                                                             Background="Transparent"
                                                             BorderThickness="0,0,0,1"
                                                             BorderBrush="#60FFFFFF"
                                                             Foreground="{Binding Message.IsFromMe, Converter={StaticResource MessageForegroundConverter}}"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="False"
                                                             MinWidth="140"
                                                             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return"
                                                                        Command="{Binding PlacementTarget.Tag.ConfirmEditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                        CommandParameter="{Binding}"/>
                                                            <KeyBinding Key="Escape"
                                                                        Command="{Binding PlacementTarget.Tag.CancelEditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                        CommandParameter="{Binding}"/>
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                        <Button Content="✓"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="#3CFFFFFF" Foreground="White"
                                                                BorderThickness="0" Padding="6,2"
                                                                FontSize="12" Cursor="Hand" Margin="0,0,4,0"
                                                                Click="ConfirmEdit_Click"/>
                                                        <Button Content="✕"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="#3CFFFFFF" Foreground="White"
                                                                BorderThickness="0" Padding="6,2"
                                                                FontSize="12" Cursor="Hand"
                                                                Click="CancelEdit_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.Resources>

                            <ItemsControl.ItemTemplateSelector>
                                <helpers:MessageItemTemplateSelector
                                    DateSeparatorTemplate="{StaticResource DateSeparatorTemplate}"
                                    MessageTemplate="{StaticResource MessageTemplate}"/>
                            </ItemsControl.ItemTemplateSelector>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Empty state -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding SelectedChat, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="💬"
                           FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Chatni tanlang va suhbatni boshlang"
                           FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Reply panel -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,8"
                    Visibility="{Binding IsReplying, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="3" CornerRadius="2"
                            Background="{DynamicResource PrimaryBrush}" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ReplyingToSenderName}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding ReplyingToPreview}"
                                   FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="✕"
                            Command="{Binding CancelReplyCommand}"
                            Background="Transparent" BorderThickness="0"
                            FontSize="13" Cursor="Hand"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Input area -->
            <Border Grid.Row="3"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,10"
                    Visibility="{Binding SelectedChat, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Emoji button -->
                    <Button Grid.Column="0"
                            x:Name="EmojiButton"
                            Width="38" Height="38"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Margin="0,0,2,0"
                            Click="EmojiButton_Click" ToolTip="Emoji qo'shish">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="😊" FontSize="18"/>
                    </Button>

                    <!-- Attach image button -->
                    <Button Grid.Column="1"
                            x:Name="SendImageButton"
                            Width="38" Height="38"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Margin="0,0,8,0"
                            Click="SendImage_Click" ToolTip="Rasm yuborish">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="📎" FontSize="18"/>
                    </Button>

                    <!-- Emoji popup -->
                    <Popup x:Name="EmojiPopup"
                           PlacementTarget="{Binding ElementName=EmojiButton}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="16" ShadowDepth="2"/>
                            </Border.Effect>
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="EmojiPanel" Width="280"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <!-- Message input -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource InputBackgroundBrush}"
                            CornerRadius="10" Padding="12,0">
                        <TextBox x:Name="MessageTextBox"
                                 Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="0,10"
                                 FontSize="14"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource PrimaryBrush}"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                            </TextBox.InputBindings>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Xabar yozing..."
                                                                       Foreground="{DynamicResource PlaceholderTextBrush}"
                                                                       Margin="0,10,0,0"
                                                                       FontSize="14"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <!-- Send button -->
                    <Button Grid.Column="3"
                            Command="{Binding SendMessageCommand}"
                            Width="38" Height="38"
                            Background="{DynamicResource PrimaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="8,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="➤" FontSize="15" Foreground="White" Margin="2,0,0,0"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════
             RIGHT PANEL OVERLAY
        ═══════════════════════════════════════════════ -->
        <Grid x:Name="RightPanelOverlay"
              Grid.Column="1"
              Background="{DynamicResource BackgroundBrush}"
              Visibility="Collapsed"
              Panel.ZIndex="5">
            <ContentControl x:Name="RightPanelContent"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════
             SIDE MENU OVERLAY
        ═══════════════════════════════════════════════ -->
        <Grid x:Name="MenuOverlay"
              Grid.ColumnSpan="2"
              Background="#60000000"
              Visibility="Collapsed"
              MouseDown="MenuOverlay_MouseDown">

            <Border x:Name="SideMenuPanel"
                    Width="260"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuTransform" X="-260"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="20" ShadowDepth="0"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- User profile header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource PrimaryBrush}"
                            Padding="20,24,20,20">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="52" Height="52" Margin="0,0,14,0">
                                <Border Width="52" Height="52" CornerRadius="26"
                                        Background="White" Opacity="0.2"/>
                                <TextBlock x:Name="MenuUserInitials"
                                           Text="{Binding MenuUserInitials}"
                                           Foreground="White"
                                           FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="MenuUserImageBorder"
                                        Width="52" Height="52" CornerRadius="26"
                                        Visibility="{Binding HasProfileImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <ImageBrush x:Name="MenuUserImage"
                                                    ImageSource="{Binding MenuUserProfileImage}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="MenuUserName"
                                           Text="{Binding MenuUserName}"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Profilni ko'rish"
                                           FontSize="12"
                                           Foreground="#BFffffff"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Menu items -->
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">

                        <Button Content="Profilni sozlash"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Padding="20,13" Cursor="Hand" FontSize="14"
                                Foreground="{DynamicResource TextBrush}"
                                Click="ProfileSettings_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Mavzuni almashtirish"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Padding="20,13" Cursor="Hand" FontSize="14"
                                Foreground="{DynamicResource TextBrush}"
                                Click="ChangeTheme_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Sozlamalar"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Padding="20,13" Cursor="Hand" FontSize="14"
                                Foreground="{DynamicResource TextBrush}"
                                Click="Settings_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Muallif"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Padding="20,13" Cursor="Hand" FontSize="14"
                                Foreground="{DynamicResource TextBrush}"
                                Click="About_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="16,8"/>

                        <Button Content="Chiqish"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Padding="20,13" Cursor="Hand" FontSize="14"
                                Foreground="#EF4444"
                                Click="Logout_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFF5F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
