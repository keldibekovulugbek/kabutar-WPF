<UserControl x:Class="Kabutar_WPF.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryBrush}"
                Padding="20,15">
            <Grid>
                <TextBlock Text="Muallif"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Button Content="&#x2715;"
                        Click="Close_Click"
                        HorizontalAlignment="Right"
                        Width="30" Height="30"
                        Background="#33FFFFFF"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>


        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,30" HorizontalAlignment="Center">


                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="30,30"
                        MaxWidth="400">
                    <StackPanel HorizontalAlignment="Center">


                        <Border Width="120" Height="120"
                                CornerRadius="60"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="3"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <Border Width="114" Height="114"
                                    CornerRadius="57"
                                    Background="{DynamicResource PrimaryBrush}">
                                <TextBlock Text="UK"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Border>


                        <TextBlock Text="Keldibekov Ulug'bek"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>


                        <TextBlock Text="Software Engineer"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>


                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,0,0,20"/>


                        <StackPanel Margin="0,0,0,0">

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#127979;"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center">
                                    <Run FontWeight="SemiBold">O'quv muassasasi:</Run>
                                    <Run>Toshkent Axborot Texnologiyalari Universiteti</Run>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#128205;"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center">
                                    <Run FontWeight="SemiBold">Joylashuv:</Run>
                                    <Run>Toshkent, O'zbekiston</Run>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#128197;"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center">
                                    <Run FontWeight="SemiBold">Yil:</Run>
                                    <Run>2025</Run>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#128279;"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center">
                                    <Run FontWeight="SemiBold">GitHub:</Run>
                                    <Run>github.com/keldibekovulugbek</Run>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#128161;"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center">
                                    <Run FontWeight="SemiBold">Loyiha:</Run>
                                    <Run>Kabutar — xavfsiz messenjer</Run>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBlock Text="&#128296;"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center">
                                    <Run FontWeight="SemiBold">Texnologiyalar:</Run>
                                    <Run>.NET 8, WPF, SignalR, PostgreSQL</Run>
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>


                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,20,0,16"/>


                        <TextBlock Text="Diplom ishi sifatida taqdim etilgan"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   FontStyle="Italic"/>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
